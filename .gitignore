# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
frontend/dist/
frontend/.next/
frontend/build/
backend/dist/

# ── Environment files (NEVER commit these) ────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development
backend/.env
frontend/.env.local
frontend/.env.production.local

# ── Vercel (contains secrets — never commit) ──────────────────────────────────
.vercel/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pino.log

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
frontend/coverage/
backend/coverage/
frontend/playwright-report/
frontend/test-results/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Root-level package files (stray npm installs) ─────────────────────────────
/package.json
/package-lock.json
