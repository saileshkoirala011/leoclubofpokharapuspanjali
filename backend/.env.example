# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:       mongodb://localhost:27017/leoclub_auth
# Atlas:       mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/leoclub_auth?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/leoclub_auth

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local:       redis://localhost:6379
# Upstash/etc: rediss://<user>:<password>@host:port
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate strong secrets with:  openssl rand -base64 64
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CSRF ──────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 64
CSRF_SECRET=change_me_csrf_secret_at_least_32_chars_long

# ── Frontend ──────────────────────────────────────────────────────────────────
# Development: http://localhost:3000
# Production:  https://your-project.vercel.app
FRONTEND_URL=http://localhost:3000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Gmail: use an App Password — NOT your account password.
# Generate at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification on the Gmail account.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM="Leo Club Puspanjali <your_gmail@gmail.com>"

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
RESET_TOKEN_EXPIRES_MINUTES=60
