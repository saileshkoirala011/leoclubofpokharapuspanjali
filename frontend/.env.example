# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment variables
# Copy this file to .env.local and fill in the values.
#
# NEXT_PUBLIC_* variables are exposed to the browser.
# Never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# URL of the backend API.
# Development (local backend):   http://localhost:5000/api
# Development (Render backend):  https://your-backend.onrender.com/api
# Production: leave blank — Vercel rewrites in vercel.json proxy /api/* automatically.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Canonical public URL of this site.
# Development: http://localhost:3000
# Production:  https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
