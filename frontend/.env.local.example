# ── Copy this file to .env.local for local development ───────────────────────
# These values are also set as Environment Variables in the Vercel dashboard.

# URL of your deployed Express backend (Render / Railway / etc.)
# In development use: http://localhost:5000/api
NEXT_PUBLIC_API_URL=https://your-backend-url.onrender.com/api

# Canonical public URL of your Vercel deployment
# In development use: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
